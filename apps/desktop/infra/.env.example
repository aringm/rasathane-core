# Rasathane Yerel İçerik Gözlemevi — örnek ortam değişkenleri.
# Sistem makul varsayılanlarla (yerel-öncelikli, KVKK fail-closed) çalışır. Yalnız Reddit
# edinimi, onaylı OAuth erişimiyle üretilen REDDIT_ACCESS_TOKEN olmadan açıkça reddedilir.
# Gerçek .env'i ASLA commit etme. Anahtarlar yalnız env'de — config/komut satırına yazılmaz.

# ─────────────── Temel ───────────────
# Çıktı kökü (boşsa: yeni kurulumda Masaüstü\Rasathane  Gözlemevi — çift boşluk kasıtlı).
# Mevcut Masaüstü\Rasathane Gözlemleri ya da Masaüstü\Youtube Analizleri varsa, veri göçüne
# kadar o legacy klasör kullanılmaya devam eder (göç: infra/gozlem-koku-goc.py)
YT_OUTPUT_BASE=
# LangGraph checkpoint dizini (boşsa: ~\.ytanaliz)
YT_CHECKPOINT_DIR=
# Yerel model sunucusu. Loopback DEĞİLse KVKK gereği REDDEDİLİR (bkz. YT_ALLOW_REMOTE_OLLAMA).
OLLAMA_HOST=http://127.0.0.1:11434
# Yerel-yol kanıtı ping modeli (makinede kurulu bir chat modeli; yoksa en küçüğüne düşer)
OLLAMA_PING_MODEL=qwen2.5:14b

# ─────────────── Gömülü llama.cpp motoru (kurulumda Ollama GEREKMEZ) ───────────────
# Backend: auto (gömülü motor varsa llamacpp, yoksa ollama) | llamacpp | ollama
YT_MOTOR_BACKEND=auto
# RAM profili: boşsa fiziksel RAM'e göre (<12GB → ram8: Gemma 4 E4B QAT; ≥12GB → ram16: 12B QAT)
YT_LLAMACPP_PROFIL=
# Endpoint'ler (yalnız loopback — Ollama ile aynı KVKK fail-closed kontratı)
YT_LLAMACPP_HOST=http://127.0.0.1:8077
YT_LLAMACPP_EMBED_HOST=http://127.0.0.1:8091
# Motor kökü (llama-server.exe + modeller/). Paketli kurulumda Electron otomatik ayarlar.
# Geliştirmede varsayılan: infra/vendor/motor (infra/fetch-motor.ps1 ile indirilir)
RASATHANE_MOTOR_DIR=

# ─────────────── Yerel modeller (gelişmiş — varsayılanlar makineye göre) ───────────────
YT_EMBED_MODEL=bge-m3
YT_CEVIRI_MODEL=qwen2.5:14b
YT_MAP_MODEL=qwen2.5:14b
YT_REDUCE_MODEL=qwen2.5:14b
YT_JUDGE_MODEL=qwen2.5:14b
YT_VERDICT_MODEL=qwen2.5:14b
YT_CLAIM_MODEL=qwen2.5:14b
YT_MEMORY_MODEL=qwen2.5:14b
YT_HARITA_MODEL=qwen2.5:14b
# ≤16GB değişmezi (#2): KV cache'i sınırlar. 14B@32K=17GB tek 16GB GPU'ya SIĞMAZ — bilmeden artırma.
YT_OLLAMA_NUM_CTX=8192
# Piper TR ses modeli klasörü (boşsa: <çıktı kökü>\_models\piper)
YT_PIPER_VOICE_DIR=

# ─────────────── Kaynak adapter'ları ───────────────
# Public GitHub repository analizi anahtarsız çalışır; token rate limit'i yükseltir.
GITHUB_TOKEN=
# Public Hugging Face model/dataset/Space analizi anahtarsız çalışır; private/gated
# erişim ancak yetkili token ile mümkündür. Rasathane ağırlık indirmez ve kod çalıştırmaz.
HF_TOKEN=
# Reddit için ZORUNLU: Reddit tarafından onaylanmış OAuth erişiminden alınan access token.
# Token yoksa Reddit URL'si genel web adapter'ına düşmez; `auth_gerekli` hatası döner.
REDDIT_ACCESS_TOKEN=

# ─────────────── Bulut / web (İSTEĞE BAĞLI — KVKK ikili kilit) ───────────────
# Ürün cloud çağrıları YALNIZCA Anthropic API key ile (OAuth/abonelik token YASAK).
ANTHROPIC_API_KEY=
# Bulut muhakeme modeli + bilinçli açma (PII-temiz + hedef=cloud şart; reddi local'e düşer).
YT_ANTHROPIC_MODEL=claude-sonnet-4-6
YT_CLOUD_VERDICT=
# Web fact-check araması (yoksa fact-check 'web_yok' der; sistem çalışmaya devam eder).
SERPER_API_KEY=
# Bulut TTS (PII'li özet daima yerel Piper'a düşer). YT_TTS_CLOUD=1 ile bilinçli açılır.
OPENAI_API_KEY=
YT_TTS_CLOUD_MODEL=gpt-4o-mini-tts
YT_TTS_CLOUD=

# ─────────────── YouTube erişim (isteğe bağlı) ───────────────
# Tarayıcı çerezi (yaş/erişim kısıtı): firefox|chrome|edge ...
YT_COOKIES_BROWSER=
# bgutil PO-token sağlayıcı tabanı (NOT: yt-dlp tarafı pip plugin'i de gerekir — runbook).
YT_POT_BASE_URL=
# ASR/NER ayrı Python ortamı (paketlenmiş exe'den gerçek Whisper/NER için).
# NER (tam web fact-check): transformers'lı bir python verin (ör. repo .venv'i
# `uv sync ... --group ner` ile). Boşsa exe repo .venv'ini OTO-TESPİT eder (kurulamazsa
# GUI rozeti "NER: yok" der + web fact-check fail-closed bloklanır — kişi içeren iddialar
# web'e gitmez). Worker repo `core/`'unu PYTHONPATH'ten import eder (frozen exe oto-bulur).
YT_ASR_PYTHON=
YT_NER_PYTHON=

# ─────────────── Çalışma toggle'ları ───────────────
# KVKK istisnası: OLLAMA_HOST loopback değilse PII uzak host'a gidebilir — bilinçli onay (=1).
YT_ALLOW_REMOTE_OLLAMA=
# Yerel gözlemlenebilirlik (Phoenix trace). Varsayılan 0; collector hazırsa bilinçli olarak 1.
YT_PHOENIX=0

# ─────────────── ⚠️ TEST FIXTURE'LARI — ÜRETİMDE SET ETMEYİN ───────────────
# YT_NER_FIXTURE: ad-soyad NER guard'ını ZAYIFLATIR (tek fail-open seam). Üretimde set
# kalırsa çıplak ad-soyad PII'si cloud/web'e sızabilir. kurulum_kontrol.ner_fixture_aktif
# false olmalı. Diğer fixture'lar (YT_*_FIXTURE) yalnız hermetik test/selftest içindir.
# RASATHANE_SOURCE_FIXTURE kaynak adapter'larını canned belgeye çevirir. ÜRETİMDE KAPALI
# kalmalıdır. HTTP/stdio başlangıcı fixture'ları varsayılan olarak siler; yalnız bilinçli
# demo/test için YT_ALLOW_FIXTURES=1 ile korunurlar.
# RASATHANE_SOURCE_FIXTURE=
# YT_ALLOW_FIXTURES=
# YT_NER_FIXTURE=
# YT_LLM_FIXTURE=  YT_EMBED_FIXTURE=  YT_TTS_FIXTURE=  YT_WEBSEARCH_FIXTURE=  YT_TRANSCRIPT_FIXTURE=
