# Gerçek secrets Git'e alınmaz. Standalone Electron bu değerleri userData üzerinden yönetir.
RASATHANE_DATA_DIR=
YT_OUTPUT_BASE=
YT_CHECKPOINT_DIR=
YT_MOTOR_BACKEND=llamacpp
YT_LLAMACPP_PROFIL=ram8
RASATHANE_MOTOR_DIR=
RASATHANE_WORKER_EXE=
RASATHANE_NER_MODEL=
RASATHANE_ASR_MODEL=
RASATHANE_NATIVE_TTS=1
YT_TTS_CLOUD=0
YT_CLOUD_VERDICT=0
YT_PHOENIX=0
# Yönetilen kaynak servisi opsiyoneldir; yapılandırılmadığında yerel çekirdek çalışır.
RASATHANE_MUHAKEME_API_URL=https://www.muhakeme.ai
RASATHANE_MUHAKEME_API_TOKEN=
RASATHANE_TYPST_BIN=
# Windows release build: CurrentUser certificate store + Windows SDK; CKA credentials burada tutulmaz.
RASATHANE_SIGN_THUMBPRINT=
RASATHANE_SIGNTOOL_PATH=
