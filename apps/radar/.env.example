# ============================================================
# Rasathane environment variables
# Copy this file to .env and fill in real values.
# Never commit .env — gitleaks pre-commit hook will block secrets.
# ============================================================

# ===== Application =====
APP_ENV=development
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# ===== Database & cache =====
# Host ports shifted (5435/6381) to coexist with muhakeme.ai's local stack.
DATABASE_URL=postgresql+asyncpg://rasathane:rasathane@localhost:5435/rasathane
REDIS_URL=redis://localhost:6381/0

# ===== LLM providers (Phase 2+) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local Ollama (private data + embeddings)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIVATE=qwen3.8-heretic:27b-q8-mtp
OLLAMA_MODEL_EMBED=qwen3-embedding:0.6b-memory-cpu

# Windows local installation (scripts/windows/Baslat-Radar.ps1 overrides these)
RASATHANE_PORT=8775
RASATHANE_NO_BROWSER=1
RASATHANE_ENABLE_CRON=0
RASATHANE_AUTO_BRIEF=0
LOCAL_LLM_PROVIDER=ollama
OLLAMA_MODEL_CHAT=gemma4-e2b-qat:latest
# The embedding model must produce 1024-dimensional vectors for this database.
# Keep this empty unless a Whisper HTTP service is actually running.
WHISPER_API_URL=

# ===== TTS (Phase 4) =====
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_TR=
ENABLE_LOCAL_TTS=false

# ===== Telegram delivery (Phase 4) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== muhakeme.ai MCP (Phase 7) =====
# Detection order: railway env → curl probe → user input.
# See README "muhakeme.ai MCP URL detection" section.
MUHAKEME_MCP_URL=

# ===== Twitter/X scraping (Phase 8) =====
# Use TWO dedicated puppet accounts — never the user's main account.
TWITTER_ACCOUNT_1_USERNAME=
TWITTER_ACCOUNT_1_PASSWORD=
TWITTER_ACCOUNT_1_AUTH_TOKEN=
TWITTER_ACCOUNT_2_USERNAME=
TWITTER_ACCOUNT_2_PASSWORD=
TWITTER_ACCOUNT_2_AUTH_TOKEN=
PROXY_URL=

# ===== Reddit (Phase 8) =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=rasathane/0.1 by aringm

# ===== GitHub (Phase 6) =====
GITHUB_TOKEN=

# ===== Auth (Phase 9 — better-auth, single-user mode) =====
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ===== Schedule =====
DAILY_BRIEF_TIME=08:00
ENABLED_SOURCES=rss

# ===== Optional debugging =====
SQL_ECHO=false
HTTP_DEBUG=false
